# $Id$

dnl Process this file with autoconf to produce a configure script.
AC_INIT(dsh.c)

dnl Checks for programs.
AC_PROG_CC
AC_CANONICAL_HOST
AC_PROG_INSTALL

dnl Checks for libraries.
dnl Replace `main' with a function in -lgen:
AC_CHECK_LIB(gen, main)
dnl Replace `main' with a function in -lnsl:
AC_CHECK_LIB(nsl, main)
dnl Replace `main' with a function in -lresolv:
AC_CHECK_LIB(resolv, main)
dnl Replace `main' with a function in -lsocket:
AC_CHECK_LIB(socket, main)

# Check for some target-specific stuff
case "$host" in
*-*-linux*)
	;;

*-*-solaris*)
	LIBS="$LIBS -lnsl -lsocket -lresolv -lgen"
	;;
esac

dnl Checks for header files.
AC_HEADER_STDC
AC_HEADER_SYS_WAIT
AC_CHECK_HEADERS(fcntl.h sys/time.h unistd.h netdb.h)

dnl Checks for typedefs, structures, and compiler characteristics.
AC_C_CONST
AC_TYPE_PID_T
AC_HEADER_TIME

dnl Checks for library functions.
AC_FUNC_MMAP
AC_TYPE_SIGNAL
AC_FUNC_VPRINTF
AC_CHECK_FUNCS(putenv select strdup strerror)

AC_EXEEXT
AC_OUTPUT(Makefile)
