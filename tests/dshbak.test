#!/bin/sh
# dshbak: formatting and -c collation of "host: line" input.
set -e

DSHBAK=${DSHBAK:-../dshbak/dshbak}

input='host1: alpha
host2: alpha
host3: beta'

# Plain: one "HOSTS" block per host (3 hosts -> 3 blocks).
plain=$(printf '%s\n' "$input" | "$DSHBAK")
n=$(printf '%s\n' "$plain" | grep -c '^HOSTS ')
if [ "$n" -ne 3 ]; then
	echo "plain: expected 3 HOSTS blocks, got $n"; printf '%s\n' "$plain"; exit 1
fi
printf '%s\n' "$plain" | grep -q '^beta$' || { echo "plain: missing beta output"; exit 1; }

# Width: piped (non-tty) output uses the fixed 78-column default: the rule is
# 78 dashes and the HOSTS line is "HOSTS " plus 72 dashes.
printf '%s\n' "$plain" | grep -qE '^-{78}$' || {
	echo "width: expected a 78-dash rule in piped output"; printf '%s\n' "$plain"; exit 1
}
printf '%s\n' "$plain" | grep -qE '^HOSTS -{72}$' || {
	echo "width: expected 'HOSTS ' + 72 dashes in piped output"; printf '%s\n' "$plain"; exit 1
}

# -c: one block per unique output (alpha, beta -> 2 blocks), with host1 and
# host2 collated onto the same host line.
coll=$(printf '%s\n' "$input" | "$DSHBAK" -c)
n=$(printf '%s\n' "$coll" | grep -c '^HOSTS ')
if [ "$n" -ne 2 ]; then
	echo "-c: expected 2 HOSTS blocks, got $n"; printf '%s\n' "$coll"; exit 1
fi
printf '%s\n' "$coll" | grep -Eq 'host1.*host2|host2.*host1' || {
	echo "-c: host1/host2 were not collated together"; printf '%s\n' "$coll"; exit 1
}

# -x: compact mode. No HOSTS headers; each line printed as "host: line", hosts
# sorted by name, lines in arrival order within a host.
input_x='host2: b1
host1: a1
host2: b2
host1: a2'
want_x='host1: a1
host1: a2
host2: b1
host2: b2'
got_x=$(printf '%s\n' "$input_x" | "$DSHBAK" -x)
if [ "$got_x" != "$want_x" ]; then
	echo "-x: unexpected output"; echo "--- want ---"; printf '%s\n' "$want_x"
	echo "--- got ---"; printf '%s\n' "$got_x"; exit 1
fi
printf '%s\n' "$got_x" | grep -q '^HOSTS ' && { echo "-x: should emit no HOSTS headers"; exit 1; }

# -x prefixes every line, including a blank one (dsh formats a blank remote
# line as "host: "); the header modes drop blanks, but -x must keep them.
blank_x=$(printf 'h1: one\nh1: \nh1: two\n' | "$DSHBAK" -x)
nb=$(printf '%s\n' "$blank_x" | wc -l | tr -d ' ')
if [ "$nb" -ne 3 ]; then
	echo "-x: expected 3 lines incl. the blank, got $nb"; printf '%s\n' "$blank_x"; exit 1
fi

# -c and -x are mutually exclusive: combining them is an error.
if printf 'host1: a\n' | "$DSHBAK" -c -x >/dev/null 2>&1; then
	echo "-c -x: expected a non-zero exit, got success"; exit 1
fi

echo "dshbak: OK"
